{
  "name": "@lenovo/agent-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "AI Coding Agent SDK (NestJS dynamic modules): session / runner / routing / gateway / workspace / scheduled-task capabilities. Channel capability ships separately as @lenovo/agent-sdk-channel.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://registry-smb.lenovo.com",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@lenovo/agent-protocol": "workspace:*",
    "@lenovo/claude-cli": "^0.1.1",
    "adm-zip": "^0.5.17",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "better-sqlite3": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7",
    "ws": "^8.20.0"
  }
}
